---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import { resolveLogoAlt } from './eventMeta';

interface Props {
  logo?: ImageMetadata;
  brand: string;
}

const { logo, brand } = Astro.props;

// Decorative monogram for the text-only fallback: first character of the brand,
// uppercased. `aria-hidden` because the visible brand text already carries the
// meaning for assistive tech. Code-point-aware indexing keeps emoji / astral
// first characters (surrogate pairs) intact instead of rendering half a glyph.
const monogram = ([...brand][0] ?? '').toUpperCase();
---

{
  logo ? (
    <div class="event-card-logo event-card-logo--image">
      <Image src={logo} alt={resolveLogoAlt(brand)} class="event-card-logo-img" />
    </div>
  ) : (
    <div class="event-card-logo event-card-logo--text">
      <span class="event-card-logo-monogram" aria-hidden="true">
        {monogram}
      </span>
    </div>
  )
}

<style>
  /*
    One fixed logo column — IDENTICAL width for every card (image chip AND
    monogram tile) so the bodies all start at the same x and stay aligned. The
    card row is top-aligned, so this box sits flush with the badges + date.
  */
  .event-card-logo {
    flex: 0 0 92px;
    width: 92px;
    height: 60px;
  }

  /*
    Real brand logos sit on a neutral light chip (same 92×60 footprint as the
    monogram tile) so a dark artwork (e.g. FrosCon's dark-blue wordmark, CC BY-ND
    — used unmodified) stays legible on the DARK events band too. Theme-safe:
    identical in both themes; artwork centered + contained, never cropped.
  */
  .event-card-logo--image {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.5rem;
    border-radius: 0.6rem;
    background: #ffffff;
  }

  .event-card-logo-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /*
    Text-only fallback: the SAME 92×60 box filled with the signature gradient and
    the brand initial — an intentional designed tile, not a broken image.
  */
  .event-card-logo-monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 0.6rem;
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ev-tile-fg);
    background: var(--ev-gradient-tile);
  }
</style>
