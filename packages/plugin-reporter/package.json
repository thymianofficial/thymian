{
  "name": "@thymian/plugin-reporter",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Thymian plugin for formatting and outputting conformance analysis reports, and for reading persisted Thymian JSON reports back as `thymian:` report inputs",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/thymianofficial/thymian/issues"
  },
  "homepage": "https://thymian.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thymianofficial/thymian.git",
    "directory": "packages/plugin-reporter"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "thymian",
    "api-reports",
    "ci",
    "reporter",
    "reporting",
    "test-reporter",
    "report-converter",
    "report-merge"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0",
    "@thymian/core": "0.0.0-PLACEHOLDER"
  }
}
