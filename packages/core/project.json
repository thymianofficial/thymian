{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "tags": ["scope:core", "type:lib", "npm:public"],
  "// targets": "to see all targets run: nx show project core --web",
  "targets": {
    "generate-rule-tags-docs": {
      "dependsOn": ["build"],
      "command": "node scripts/generate-rule-tags-docs.js astro-docs/src/content/docs/references/concern-tags.md"
    },
    "generate-impossibility-docs": {
      "dependsOn": ["build"],
      "command": "node scripts/generate-impossibility-docs.js astro-docs/src/content/docs/references/impossibility-reasons.md"
    }
  }
}
