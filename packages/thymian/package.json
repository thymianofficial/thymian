{
  "name": "thymian",
  "version": "0.0.1-e2e",
  "description": "AI-ready API governance engine - lint, test & analyze HTTP conformance across your entire API lifecycle",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/thymianofficial/thymian/issues"
  },
  "homepage": "https://thymian.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thymianofficial/thymian.git",
    "directory": "packages/thymian"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "thymian",
    "api",
    "api-governance",
    "api-linter",
    "api-testing",
    "http",
    "http-conformance",
    "linter",
    "openapi",
    "rest-api",
    "rfc-9110",
    "swagger",
    "validator"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@oclif/plugin-help": "^6.2.29",
    "@oclif/plugin-not-found": "^3.2.57",
    "@oclif/plugin-version": "^2.2.30",
    "@thymian/common-cli": "0.0.1-e2e",
    "@thymian/plugin-http-analyzer": "0.0.1-e2e",
    "@thymian/plugin-http-linter": "0.0.1-e2e",
    "@thymian/plugin-http-tester": "0.0.1-e2e",
    "@thymian/plugin-openapi": "0.0.1-e2e",
    "@thymian/plugin-reporter": "0.0.1-e2e",
    "@thymian/plugin-request-dispatcher": "0.0.1-e2e",
    "@thymian/plugin-sampler": "0.0.1-e2e",
    "@thymian/plugin-spectral": "0.0.1-e2e",
    "@thymian/plugin-websocket-proxy": "0.0.1-e2e",
    "@thymian/rules-rfc-9110": "0.0.1-e2e",
    "@thymian/rules-api-description-validation": "0.0.1-e2e",
    "@thymian/plugin-har": "0.0.1-e2e",
    "open": "^8.4.2",
    "tslib": "^2.3.0",
    "@thymian/core": "0.0.1-e2e"
  },
  "bin": {
    "thymian": "./bin/run.js"
  },
  "oclif": {
    "bin": "thymian",
    "commands": "./dist/commands",
    "hooks": {
      "thymian.feedback": "./dist/hooks/feedback"
    },
    "dirname": "thymian",
    "topicSeparator": " ",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-version",
      "@thymian/plugin-http-linter"
    ]
  },
  "devDependencies": {
    "@oclif/test": "^4.1.13",
    "@types/node": "^22.15.1",
    "tsx": "^4.20.3"
  }
}
