{
  "name": "@thymian/core-testing",
  "version": "0.0.0-PLACEHOLDER",
  "description": "Testing utilities, factories, and mocks for writing Thymian plugin tests",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/thymianofficial/thymian/issues"
  },
  "homepage": "https://thymian.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/thymianofficial/thymian.git",
    "directory": "packages/core-testing"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "thymian",
    "testing",
    "test-utils",
    "plugin-testing",
    "http-mocks",
    "api-testing"
  ],
  "main": "./dist/index.js",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js",
      "default": "./dist/mocks/index.js"
    },
    "./mocks/thymian": {
      "types": "./dist/mocks/thymian.mock.d.ts",
      "import": "./dist/mocks/thymian.mock.js",
      "default": "./dist/mocks/thymian.mock.js"
    },
    "./scenarios": {
      "types": "./dist/rule-context-scenarios.d.ts",
      "import": "./dist/rule-context-scenarios.js",
      "default": "./dist/rule-context-scenarios.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@thymian/core": "0.0.0-PLACEHOLDER",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@thymian/core": "0.0.0-PLACEHOLDER",
    "vitest": "^4.1.11"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
